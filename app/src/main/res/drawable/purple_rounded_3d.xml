<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#2D0A45"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4A148C"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#9C27B0"
                android:centerColor="#7B1FA2"
                android:endColor="#5E1B7D"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#E1BEE7"/>
        </shape>
    </item>

    <item android:top="0dp" android:left="4dp" android:right="4dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</layer-list>
