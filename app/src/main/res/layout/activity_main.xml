                android:backgroundTint="#3F51B5"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:text="&#128257;&#10;&#1578;&#1603;&#1585;&#1575;&#1585; &#1575;&#1604;&#1601;&#1610;&#1583;&#1610;&#1608;"
                android:textSize="10sp" android:textColor="#FFFFFF"
