                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnScreenshot"
                android:layout_width="0dp"
                android:text="&#128248;&#10;&#1604;&#1602;&#1591;&#1577; &#1605;&#1606; &#1575;&#1604;&#1601;&#1610;&#1583;&#1610;&#1608;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#6D4C41"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnTheme"
                android:layout_width="0dp"
                android:text="&#127769;&#10;&#1608;&#1590;&#1593; &#1604;&#1610;&#1604;&#1610;/&#1606;&#1607;&#1575;&#1585;&#1610;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#37474F"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnStickers"
                android:layout_width="0dp"
                android:text="&#127912;&#10;&#1605;&#1604;&#1589;&#1602;&#1575;&#1578;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#FF6F00"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnPreciseCut"
                android:layout_width="0dp"
                android:text="&#9986;&#65039;&#10;&#1602;&#1589; &#1583;&#1602;&#1610;&#1602;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#EF6C00"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnColorAdjust"
                android:layout_width="0dp"
                android:text="&#127912;&#10;&#1590;&#1576;&#1591; &#1575;&#1604;&#1571;&#1604;&#1608;&#1575;&#1606;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#E91E63"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnFrame"
                android:layout_width="0dp"
                android:text="&#128450;&#65039;&#10;&#1573;&#1591;&#1575;&#1585;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#795548"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>


            <Button android:id="@+id/btnSocialSize"
                android:layout_width="0dp"
                android:text="&#128241;&#10;&#1571;&#1576;&#1593;&#1575;&#1583; &#1575;&#1604;&#1587;&#1608;&#1588;&#1610;&#1575;&#1604;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#5E35B1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnPiP"
                android:layout_width="0dp"
                android:text="&#127909;&#10;&#1601;&#1610;&#1583;&#1610;&#1608; &#1583;&#1575;&#1582;&#1604; &#1601;&#1610;&#1583;&#1610;&#1608;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#283593"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnSwapAudio"
                android:layout_width="0dp"
                android:text="&#128260;&#10;&#1578;&#1576;&#1583;&#1610;&#1604; &#1575;&#1604;&#1589;&#1608;&#1578;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#C62828"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnSplit"
                android:layout_width="0dp"
                android:text="&#9986;&#65039;&#10;&#1578;&#1602;&#1587;&#1610;&#1605; &#1575;&#1604;&#1601;&#1610;&#1583;&#1610;&#1608;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#F57C00"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnShadowText"
                android:layout_width="0dp"
                android:text="&#9997;&#65039;&#10;&#1606;&#1589; &#1576;&#1592;&#1604;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#303F9F"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnVideoInfo"
                android:layout_width="0dp"
                android:text="&#128202;&#10;&#1605;&#1593;&#1604;&#1608;&#1605;&#1575;&#1578; &#1575;&#1604;&#1601;&#1610;&#1583;&#1610;&#1608;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#00838F"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnExtraEffects"
                android:layout_width="0dp"
                android:text="&#127916;&#10;&#1578;&#1571;&#1579;&#1610;&#1585;&#1575;&#1578; &#1587;&#1610;&#1606;&#1605;&#1575;&#1574;&#1610;&#1577;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#4A148C"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnManualResize"
                android:layout_width="0dp"
                android:text="&#128208;&#10;&#1578;&#1593;&#1583;&#1610;&#1604; &#1575;&#1604;&#1571;&#1576;&#1593;&#1575;&#1583;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#00695C"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnToGif"
                android:layout_width="0dp"
                android:text="&#127902;&#10;&#1578;&#1581;&#1608;&#1610;&#1604; GIF"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#D84315"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnCollage"
                android:layout_width="0dp"
                android:text="&#127916;&#10;&#1603;&#1608;&#1604;&#1575;&#1580;"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#AD1457"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnCutoutImage_old_NEW"
                android:layout_width="0dp"
                android:text="✂️&#10;قطع صورة"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnAudioFade"
                android:layout_width="0dp"
                android:text="🎼&#10;تلاشي الصوت"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#AD1457"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnAudioDuck"
                android:layout_width="0dp"
                android:text="🎙️&#10;خفض الموسيقى"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnSpeedRamp"
                android:layout_width="0dp"
                android:text="🚀&#10;سرعة متدرجة"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#D84315"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnAudioBoost"
                android:layout_width="0dp"
                android:text="🎤&#10;تعزيز الصوت"
                android:textSize="10sp" android:textColor="#FFFFFF"
                android:backgroundTint="#00695C"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" android:padding="12dp"/>

            <Button android:id="@+id/btnRemoveSilence"
                android:layout_width="0dp"
                android:text="&#128263;&#10;&#1581;&#1584;&#1601; &#1575;&#1604;&#1589;&#1605;&#1578;"
